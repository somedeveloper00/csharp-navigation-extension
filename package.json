{
  "name": "csharp-extended-navigation",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": ["onLanguage:csharp"],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "check": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test test/**/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "commands": [
      { "command": "csharpExtendedNavigation.nextContext", "title": "%command.nextContext%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.previousContext", "title": "%command.previousContext%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.nextMethod", "title": "%command.nextMethod%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.previousMethod", "title": "%command.previousMethod%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.nextType", "title": "%command.nextType%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.previousType", "title": "%command.previousType%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.nextVariable", "title": "%command.nextVariable%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.previousVariable", "title": "%command.previousVariable%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.containingContext", "title": "%command.containingContext%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.contextPicker", "title": "%command.contextPicker%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.nextUsage", "title": "%command.nextUsage%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.previousUsage", "title": "%command.previousUsage%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.lastEdit", "title": "%command.lastEdit%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.navigateBack", "title": "%command.navigateBack%", "category": "%command.category%" },
      { "command": "csharpExtendedNavigation.navigateForward", "title": "%command.navigateForward%", "category": "%command.category%" }
    ],
    "keybindings": [
      { "command": "csharpExtendedNavigation.nextMethod", "key": "ctrl+alt+down", "mac": "cmd+alt+down", "when": "editorTextFocus && editorLangId == csharp" },
      { "command": "csharpExtendedNavigation.previousMethod", "key": "ctrl+alt+up", "mac": "cmd+alt+up", "when": "editorTextFocus && editorLangId == csharp" },
      { "command": "csharpExtendedNavigation.contextPicker", "key": "ctrl+shift+alt+n", "mac": "cmd+shift+alt+n", "when": "editorTextFocus && editorLangId == csharp" },
      { "command": "csharpExtendedNavigation.nextUsage", "key": "ctrl+alt+f7", "mac": "cmd+alt+f7", "when": "editorTextFocus && editorLangId == csharp" }
    ],
    "menus": {
      "editor/context": [
        { "command": "csharpExtendedNavigation.contextPicker", "when": "editorLangId == csharp", "group": "navigation@10" },
        { "command": "csharpExtendedNavigation.nextUsage", "when": "editorLangId == csharp", "group": "navigation@11" }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "csharpExtendedNavigation.wrapAround": { "type": "boolean", "default": true, "description": "%configuration.wrapAround%" },
        "csharpExtendedNavigation.includeLocalVariables": { "type": "boolean", "default": true, "description": "%configuration.includeLocalVariables%" },
        "csharpExtendedNavigation.revealPosition": { "type": "string", "enum": ["center", "top", "default"], "default": "center", "description": "%configuration.revealPosition%" }
      }
    }
  },
  "repository": { "type": "git", "url": "https://github.com/somedeveloper00/csharp-navigation-extension.git" }
}
