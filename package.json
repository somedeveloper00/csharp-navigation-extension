{
  "name": "csharp-extended-navigation",
  "displayName": "C# Extended Navigation",
  "description": "Rider-inspired structural and usage navigation for C# in VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": ["onLanguage:csharp"],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "check": "tsc -p ./ --noEmit",
    "test": "npm run check",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "commands": [
      { "command": "csharpExtendedNavigation.nextContext", "title": "C#: Go to Next Context", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.previousContext", "title": "C#: Go to Previous Context", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.nextMethod", "title": "C#: Go to Next Method", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.previousMethod", "title": "C#: Go to Previous Method", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.nextType", "title": "C#: Go to Next Type", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.previousType", "title": "C#: Go to Previous Type", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.nextVariable", "title": "C#: Go to Next Variable", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.previousVariable", "title": "C#: Go to Previous Variable", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.containingContext", "title": "C#: Go to Containing Context", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.contextPicker", "title": "C#: Navigate to Context…", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.nextUsage", "title": "C#: Go to Next Usage", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.previousUsage", "title": "C#: Go to Previous Usage", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.lastEdit", "title": "C#: Go to Last Edit", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.navigateBack", "title": "C#: Navigate Back", "category": "C# Navigation" },
      { "command": "csharpExtendedNavigation.navigateForward", "title": "C#: Navigate Forward", "category": "C# Navigation" }
    ],
    "keybindings": [
      { "command": "csharpExtendedNavigation.nextMethod", "key": "ctrl+alt+down", "mac": "cmd+alt+down", "when": "editorTextFocus && editorLangId == csharp" },
      { "command": "csharpExtendedNavigation.previousMethod", "key": "ctrl+alt+up", "mac": "cmd+alt+up", "when": "editorTextFocus && editorLangId == csharp" },
      { "command": "csharpExtendedNavigation.contextPicker", "key": "ctrl+shift+alt+n", "mac": "cmd+shift+alt+n", "when": "editorTextFocus && editorLangId == csharp" },
      { "command": "csharpExtendedNavigation.nextUsage", "key": "ctrl+alt+f7", "mac": "cmd+alt+f7", "when": "editorTextFocus && editorLangId == csharp" }
    ],
    "menus": {
      "editor/context": [
        { "command": "csharpExtendedNavigation.contextPicker", "when": "editorLangId == csharp", "group": "navigation@10" },
        { "command": "csharpExtendedNavigation.nextUsage", "when": "editorLangId == csharp", "group": "navigation@11" }
      ]
    },
    "configuration": {
      "title": "C# Extended Navigation",
      "properties": {
        "csharpExtendedNavigation.wrapAround": { "type": "boolean", "default": true, "description": "Wrap to the first or last context at file boundaries." },
        "csharpExtendedNavigation.includeLocalVariables": { "type": "boolean", "default": true, "description": "Include local variables in context and variable navigation." },
        "csharpExtendedNavigation.revealPosition": { "type": "string", "enum": ["center", "top", "default"], "default": "center", "description": "Where to reveal a navigation target in the editor." }
      }
    }
  },
  "repository": { "type": "git", "url": "https://github.com/example/csharp-extended-navigation.git" }
}
